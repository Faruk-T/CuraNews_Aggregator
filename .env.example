# Placeholder — copy to `.env` locally. Never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO
APP_NAME=CuraNews Aggregator

# Port 5433 matches docker-compose (local PostgreSQL often uses 5432 on Windows).
DATABASE_URL=postgresql+psycopg://curanews:curanews@localhost:5433/curanews
SQLITE_PATH=data/local/curanews.sqlite3
REDIS_URL=redis://localhost:6379/0

SPACY_MODEL=en_core_web_sm
FEED_CACHE_TTL_SECONDS=120
SCRAPE_MAX_RETRIES=5
SCRAPE_BACKOFF_BASE=0.5
SCRAPE_CONCURRENCY=2
SCRAPE_USER_AGENT=CuraNewsBot/0.1 (+https://github.com/Faruk-T/CuraNews_Aggregator)
SCRAPE_ALLOWLIST_HOSTS=example.com,gnews.io,localhost,127.0.0.1

NEWS_API_KEY=
NEWS_API_BASE_URL=https://gnews.io/api/v4/top-headlines

API_HOST=0.0.0.0
API_PORT=8000

PII_HASH_SALT=change-me-in-local-only
