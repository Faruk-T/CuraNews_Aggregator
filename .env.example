# Placeholder — copy to `.env` locally. Never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO
APP_NAME=CuraNews Aggregator

# Port 5433 matches docker-compose (local PostgreSQL often uses 5432 on Windows).
DATABASE_URL=postgresql+psycopg://curanews:curanews@localhost:5433/curanews
SQLITE_PATH=data/local/curanews.sqlite3
REDIS_URL=redis://localhost:6379/0

SPACY_MODEL=en_core_web_sm
FEED_CACHE_TTL_SECONDS=120
READ_INBOX_GRACE_SECONDS=1200
# Background RSS refresh inside the API (minutes). Production treats 0 as 10.
INGEST_INTERVAL_MINUTES=10
INGEST_MAX_ITEMS=2000
SCRAPE_MAX_RETRIES=5
SCRAPE_BACKOFF_BASE=0.5
SCRAPE_CONCURRENCY=2
SCRAPE_USER_AGENT=CuraNewsBot/0.1 (+https://github.com/Faruk-T/CuraNews_Aggregator)
SCRAPE_ALLOWLIST_HOSTS=example.com,gnews.io,localhost,127.0.0.1,feeds.bbci.co.uk,www.theguardian.com,feeds.npr.org,www.aljazeera.com,rss.dw.com,www.aa.com.tr,www.trthaber.com,www.ahaber.com.tr,www.ntv.com.tr,www.cnnturk.com,www.hurriyet.com.tr,www.milliyet.com.tr,www.haberturk.com

NEWS_API_KEY=
NEWS_API_BASE_URL=https://gnews.io/api/v4/top-headlines

API_HOST=0.0.0.0
API_PORT=8000

# Docker Compose sets DATABASE_URL/REDIS_URL to service hostnames (postgres/redis).
# Local Poetry runs use localhost ports above.

PII_HASH_SALT=change-me-in-local-only

# Signs login tokens. Production: 32+ random chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Public site root incl. reverse-proxy prefix, no trailing slash.
# Used for canonical URLs, sitemap, RSS and Open Graph tags.
PUBLIC_BASE_URL=
# PUBLIC_BASE_URL=https://truncgil.com/curanews

# Editor account is (re)provisioned on container start. Login stays disabled
# until EDITOR_PASSWORD is set to 12+ characters.
EDITOR_EMAIL=faruk@curanews.com
EDITOR_PASSWORD=

# Optional integrations; leave empty until you have real IDs.
ADSENSE_PUB_ID=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
